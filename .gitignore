# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# virtual environments are never committed: they are rebuilt from
# requirements.txt and are platform-specific
.venv/
venv/
env/
ENV/

# --- persistent data ---
# the SQLite file and downloaded media live on the /data volume and are
# regenerated by `python -m scripts.manage sync`
/data/
data/
*.db
*.sqlite
*.sqlite3
backend/media/

# --- secrets and local config ---
.env
.env.local
*.pem
*.key

# --- Node / frontend ---
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- editors and OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
